{
  "name": "@amashukov/eslint-plugin-mess-detector",
  "version": "0.1.1",
  "description": "ESLint plugin that fails the build on low-signal code patterns: inline narration, suppression directives, defensive nullish guards, tautological JSDoc, banal error wrappers, env branching, direct Date.now, type-only test assertions, TODO markers.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "typescript",
    "code-quality",
    "static-analysis"
  ],
  "homepage": "https://github.com/AndreyMashukov/eslint-plugin-mess-detector#readme",
  "bugs": {
    "url": "https://github.com/AndreyMashukov/eslint-plugin-mess-detector/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreyMashukov/eslint-plugin-mess-detector.git"
  },
  "license": "MIT",
  "author": "Andrei Mashukov <a.mashukoff@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.18.0",
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/parser": "^8.18.0",
    "@typescript-eslint/rule-tester": "^8.18.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
